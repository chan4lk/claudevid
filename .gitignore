# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace

# Built Visual Studio Code Extensions
*.vsix

# Node / pnpm
node_modules/
dist/
*.tsbuildinfo

# Local session state (not part of the repo)
.session-id

# specclaw verify run logs (ephemeral, regenerated each run)
.specclaw/changes/*/logs/

# Local model/TTS cache (downloaded artifacts, not part of the repo)
.claudevid/

# Render output (regenerated by `claudevid render`; committed demos live in demo/)
out/

# Distributable package build output (regenerate with `pnpm package`)
dist-package/
claudevid-*.tgz
