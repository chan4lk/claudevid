{
  "version": 1,
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "background": "#111111",
  "meta": {
    "title": "Vertical Short",
    "description": "9:16 worked example for shorts-style vertical video."
  },
  "scenes": [
    {
      "id": "hook",
      "duration": 2,
      "layers": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 1080,
          "height": 1920,
          "fill": "#111111"
        },
        {
          "type": "text",
          "text": "3 Tips for Faster Renders",
          "x": "center",
          "y": 700,
          "fontSize": 72,
          "fontWeight": 700,
          "color": "#ffffff",
          "align": "center",
          "maxWidth": 900,
          "animation": { "enter": "fade-up", "duration": 0.5 }
        }
      ]
    },
    {
      "id": "tip",
      "duration": 3,
      "layers": [
        {
          "type": "text",
          "text": "Cache static layers instead of redrawing them every frame.",
          "x": "center",
          "y": "center",
          "fontSize": 56,
          "color": "#f5f5f5",
          "align": "center",
          "maxWidth": 900,
          "animation": { "enter": "fade", "duration": 0.4 }
        }
      ]
    }
  ]
}
